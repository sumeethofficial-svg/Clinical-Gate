# Copy to .env for local dev. These are EXAMPLE values for a throwaway local database; never reuse them.
# Admin/owner connection: migrations, seeding and the eval ground-truth oracle ONLY.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinicalgate
# Runtime connection template. The user part is ignored: the API connects as cg_app_<persona> (one login per persona), all sharing CG_APP_PASSWORD.
DATABASE_URL_APP=postgresql://ignored:change-me-app-password@localhost:5432/clinicalgate
CG_APP_PASSWORD=change-me-app-password
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
TOKEN_TTL_SECONDS=900
# Password for the seeded demo users (fd_sam, nurse_ana, nurse_raj, billing_lee, manager_kim)
DEMO_PASSWORD=demo-password
# heuristic (no key needed) | anthropic | openai
LLM_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
